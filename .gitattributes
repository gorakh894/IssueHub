# Set default behavior to automatically normalize line endings
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf
mvnw text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
mvnw.cmd text eol=crlf

# Java source files
*.java text diff=java

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
