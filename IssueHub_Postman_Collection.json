						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"1234567890\",\n  \"role\": \"EMPLOYEE\",\n  \"department\": \"IT\",\n  \"employeeId\": \"TEST001\"\n}"
