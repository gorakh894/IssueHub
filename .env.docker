# Docker Environment Configuration
# Copy this file to .env and update with your actual values

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme123!
MONGODB_DATABASE=issuehub

# JWT Configuration
# Generate a secure secret using: openssl rand -base64 64
JWT_SECRET=0Ayv4gmHq088BwhGBbX6nk9+XNeFdx9xGsrOQyd1FVk=
JWT_EXPIRATION=604800000

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:80

# Server Ports
SERVER_PORT=8080
FRONTEND_PORT=3000

# Frontend API URL (for production deployment)
VITE_API_BASE_URL=http://localhost:8080/api

# Spring Profile
SPRING_PROFILES_ACTIVE=docker
